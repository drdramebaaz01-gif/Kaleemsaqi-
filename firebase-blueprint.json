{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store product catalog item in DK Mart",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Product title" },
        "code": { "type": "string", "description": "Unique product SKU or code" },
        "description": { "type": "string", "description": "Detailed description of the product" },
        "price": { "type": "number", "description": "Product price in PKR" },
        "discountPercentage": { "type": "integer", "description": "Discount percentage (0-99)" },
        "category": { "type": "string", "description": "Product category" },
        "stock": { "type": "integer", "description": "Available stock quantity" },
        "images": {
          "type": "array",
          "description": "List of product image URLs or Base64 encoded strings"
        },
        "featured": { "type": "boolean", "description": "Whether product is featured" },
        "isFlashSale": { "type": "boolean", "description": "Flash sale badge" },
        "isTrending": { "type": "boolean", "description": "Trending badge" },
        "isBestSeller": { "type": "boolean", "description": "Best seller badge" },
        "isNewArrival": { "type": "boolean", "description": "New arrival badge" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp via serverTimestamp" }
      },
      "required": ["name", "code", "price", "category", "stock", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer cash on delivery order in DK Mart",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of customer" },
        "customerName": { "type": "string", "description": "Full customer name" },
        "mobileNumber": { "type": "string", "description": "Primary mobile number for delivery contact" },
        "whatsappNumber": { "type": "string", "description": "WhatsApp contact number" },
        "city": { "type": "string", "description": "Delivery city" },
        "deliveryAddress": { "type": "string", "description": "Complete street delivery address" },
        "items": { "type": "array", "description": "Ordered line items summary" },
        "totalAmount": { "type": "number", "description": "Total order amount in PKR" },
        "paymentMethod": { "type": "string", "description": "Payment method (Cash on Delivery)" },
        "status": {
          "type": "string",
          "enum": ["Pending", "Confirmed", "Processing", "Shipped", "Delivered", "Cancelled"],
          "description": "Order progression status"
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "Order placement timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Order last status update timestamp" }
      },
      "required": ["userId", "customerName", "mobileNumber", "city", "deliveryAddress", "totalAmount", "status", "createdAt"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "Customer shopping cart entry",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "description": "Product document ID" },
        "name": { "type": "string", "description": "Product name" },
        "price": { "type": "number", "description": "Unit price in PKR" },
        "discountPercentage": { "type": "integer", "description": "Discount percentage" },
        "image": { "type": "string", "description": "Primary image URL or thumbnail" },
        "quantity": { "type": "integer", "description": "Quantity to purchase" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Item added timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Item quantity updated timestamp" }
      },
      "required": ["productId", "name", "price", "quantity", "createdAt"]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "Customer saved wishlist entry",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "description": "Product document ID" },
        "name": { "type": "string", "description": "Product name" },
        "price": { "type": "number", "description": "Unit price in PKR" },
        "discountPercentage": { "type": "integer", "description": "Discount percentage" },
        "image": { "type": "string", "description": "Primary image URL or thumbnail" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Added timestamp" }
      },
      "required": ["productId", "name", "price", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Customer account profile",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User UID" },
        "displayName": { "type": "string", "description": "User display name" },
        "email": { "type": "string", "description": "User Google email" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account registration timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Account profile update timestamp" }
      },
      "required": ["userId", "displayName", "email", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "DK Mart store administrator entry",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Admin email address" },
        "role": { "type": "string", "description": "Store admin role" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Admin authorization timestamp" }
      },
      "required": ["email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Global product catalog managed by admins and browsed by authenticated customers"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store customer orders managed by admins and viewable by the order owner"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile"
    },
    "/users/{userId}/cart/{cartItemId}": {
      "schema": "CartItem",
      "description": "Customer shopping cart subcollection"
    },
    "/users/{userId}/wishlist/{wishlistItemId}": {
      "schema": "WishlistItem",
      "description": "Customer wishlist subcollection"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Designated admin identifiers"
    }
  }
}
