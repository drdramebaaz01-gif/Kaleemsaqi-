rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kaleemsaqi01@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.code is string && data.code.size() > 0 && data.code.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.category is string && data.category.size() <= 100 &&
             data.stock is int && data.stock >= 0 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
             (!('discountPercentage' in data) || (data.discountPercentage is int && data.discountPercentage >= 0 && data.discountPercentage <= 99)) &&
             (!('images' in data) || (data.images is list && data.images.size() <= 10)) &&
             (!('featured' in data) || data.featured is bool) &&
             (!('isFlashSale' in data) || data.isFlashSale is bool) &&
             (!('isTrending' in data) || data.isTrending is bool) &&
             (!('isBestSeller' in data) || data.isBestSeller is bool) &&
             (!('isNewArrival' in data) || data.isNewArrival is bool);
    }

    function isValidOrder(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 150 &&
             data.mobileNumber is string && data.mobileNumber.size() >= 7 && data.mobileNumber.size() <= 25 &&
             data.city is string && data.city.size() > 0 && data.city.size() <= 100 &&
             data.deliveryAddress is string && data.deliveryAddress.size() > 0 && data.deliveryAddress.size() <= 500 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ['Pending', 'Confirmed', 'Processing', 'Shipped', 'Delivered', 'Cancelled'] &&
             (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 25)) &&
             (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50)) &&
             (!('items' in data) || (data.items is list && data.items.size() <= 100));
    }

    function isValidCartItem(data) {
      return data.productId is string && data.productId.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.quantity is int && data.quantity > 0 && data.quantity <= 1000 &&
             (!('discountPercentage' in data) || (data.discountPercentage is int && data.discountPercentage >= 0)) &&
             (!('image' in data) || (data.image is string && data.image.size() <= 500000));
    }

    function isValidWishlistItem(data) {
      return data.productId is string && data.productId.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             (!('discountPercentage' in data) || (data.discountPercentage is int && data.discountPercentage >= 0)) &&
             (!('image' in data) || (data.image is string && data.image.size() <= 500000));
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 150 &&
             data.email is string && data.email.size() <= 200;
    }

    // Products collection: Customers can read; Admins can write
    match /products/{productId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && isValidId(productId) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       isValidProduct(incoming());
      allow update: if isAdmin() && isValidId(productId) &&
                       incoming().createdAt == existing().createdAt &&
                       isValidProduct(incoming());
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Orders collection: Customer sees own orders, Admin sees all orders
    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(orderId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       isValidOrder(incoming());
      allow update: if isSignedIn() && isValidId(orderId) && (
                       (isAdmin() && isValidOrder(incoming())) ||
                       (existing().userId == request.auth.uid &&
                        incoming().userId == existing().userId &&
                        incoming().createdAt == existing().createdAt &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                        incoming().status == 'Cancelled')
                    );
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Users collection and private subcollections
    match /users/{userId} {
      allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming());
      allow delete: if isSignedIn() && request.auth.uid == userId;

      match /cart/{cartItemId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(cartItemId) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         isValidCartItem(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(cartItemId) &&
                         incoming().createdAt == existing().createdAt &&
                         isValidCartItem(incoming());
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(cartItemId);
      }

      match /wishlist/{wishlistItemId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(wishlistItemId) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         isValidWishlistItem(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(wishlistItemId) &&
                         incoming().createdAt == existing().createdAt &&
                         isValidWishlistItem(incoming());
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(wishlistItemId);
      }
    }

    // Admins registry
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(adminId);
    }
  }
}
